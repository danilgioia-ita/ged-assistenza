<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight interno (App Store Connect), mai App Store pubblico. Il nome del profilo e' lo stesso di
	     PROVISIONING_PROFILE_SPECIFIER nel progetto Xcode: il flusso ged-ios.yml deve installare un profilo con
	     QUESTO nome per it.gedservice.assistenza.tecnico. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>X728M3V35H</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>destination</key>
	<string>export</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>it.gedservice.assistenza.tecnico</key>
		<string>GED Assistance Tecnico App Store</string>
	</dict>
</dict>
</plist>
